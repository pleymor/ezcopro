rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: vérifie si l'utilisateur est membre d'une copropriété
    function isMember(coproId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/coproprietes/$(coproId)).data.members;
    }

    // Helper: vérifie si l'utilisateur est syndic de la copropriété
    function isSyndic(coproId) {
      return request.auth != null &&
        request.auth.token.role == 'syndic' &&
        request.auth.token.coproprieteId == coproId;
    }

    // Helper: vérifie si l'utilisateur est copropriétaire de la copropriété
    function isCoproprietaire(coproId) {
      return request.auth != null &&
        request.auth.token.role == 'coproprietaire' &&
        request.auth.token.coproprieteId == coproId;
    }

    // Helper: vérifie si l'utilisateur est le copropriétaire concerné
    function isOwnCoproprietaire(coproId, coproprietaireId) {
      return isCoproprietaire(coproId) &&
        request.auth.token.coproprietaireId == coproprietaireId;
    }

    // Users: lecture/écriture de son propre profil uniquement
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Copropriétés: membres uniquement
    match /coproprietes/{coproId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.members;
      allow delete: if false; // Jamais supprimé

      // Sous-collections
      match /lots/{lotId} {
        allow read, write: if isMember(coproId);
      }

      match /coproprietaires/{cpId} {
        allow read, write: if isMember(coproId);
      }

      match /appels/{appelId} {
        // Lecture: syndic ou copropriétaire (pour voir ses appels)
        allow read: if isMember(coproId) || isCoproprietaire(coproId);
        // Écriture: syndic uniquement
        allow write: if isMember(coproId);

        match /repartitions/{repId} {
          // Lecture: syndic ou copropriétaire concerné
          allow read: if isMember(coproId) ||
            (isCoproprietaire(coproId) && resource.data.coproprietaireId == request.auth.token.coproprietaireId);
          allow write: if isMember(coproId);
        }
      }

      match /paiements/{paiementId} {
        // Lecture: syndic ou copropriétaire concerné
        allow read: if isMember(coproId) ||
          (isCoproprietaire(coproId) && resource.data.coproprietaireId == request.auth.token.coproprietaireId);
        // Écriture: syndic uniquement
        allow write: if isMember(coproId);
      }

      match /clesRepartition/{cleId} {
        allow read, write: if isMember(coproId);
      }

      match /historique/{entryId} {
        allow read: if isMember(coproId);
        allow create: if isMember(coproId);
        allow update, delete: if false;
      }

      match /assemblees-generales/{agId} {
        allow read, write: if isMember(coproId);

        match /resolutions/{resId} {
          allow read, write: if isMember(coproId);

          match /votes/{voteId} {
            allow read, write: if isMember(coproId);
          }
        }

        match /presences/{presId} {
          allow read, write: if isMember(coproId);
        }
      }
    }

    // Invitations copropriété: lecture publique pour validation, écriture par membres
    match /invitations/{code} {
      allow read: if true;
      allow create: if request.auth != null &&
        isMember(request.resource.data.coproprieteId);
      allow update: if request.auth != null &&
        resource.data.usedAt == null; // Seulement si pas encore utilisé
      allow delete: if false;
    }

    // Invitations extranet copropriétaires
    match /invitationsExtranet/{invitationId} {
      // Lecture publique pour validation du token (page d'acceptation)
      allow read: if true;
      // Création par syndic uniquement
      allow create: if request.auth != null &&
        isSyndic(request.resource.data.coproprieteId);
      // Mise à jour (acceptation) par n'importe qui avec le bon token
      // ou par le syndic pour renvoi
      allow update: if request.auth != null && (
        resource.data.statut == 'en_attente' ||
        isSyndic(resource.data.coproprieteId)
      );
      allow delete: if isSyndic(resource.data.coproprieteId);
    }

    // Documents partagés (GED extranet)
    match /coproprietes/{coproId}/documentsPartages/{docId} {
      // Lecture: syndic ou copropriétaire (si visibleExtranet = true)
      allow read: if isSyndic(coproId) ||
        (isCoproprietaire(coproId) && resource.data.visibleExtranet == true);
      // Écriture: syndic uniquement
      allow create, update, delete: if isSyndic(coproId);
    }

    // Préférences de notification des copropriétaires
    match /preferencesNotification/{userId} {
      // Lecture/écriture par l'utilisateur lui-même
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}