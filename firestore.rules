rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is the condo owner (syndic)
    function isCondoOwner(condoId) {
      let condo = get(/databases/$(database)/documents/condos/$(condoId)).data;
      return request.auth != null && condo.ownerId == request.auth.uid;
    }

    // Helper: check if user is a board member (conseil syndical)
    function isBoardMember(condoId) {
      let condo = get(/databases/$(database)/documents/condos/$(condoId)).data;
      return request.auth != null &&
        condo.boardMemberIds != null &&
        request.auth.uid in condo.boardMemberIds;
    }

    // Helper: check if user can read (owner or board member)
    function canReadCondo(condoId) {
      return isCondoOwner(condoId) || isBoardMember(condoId);
    }

    // Helper: check if user can write (only owner)
    function canWriteCondo(condoId) {
      return isCondoOwner(condoId);
    }

    // Helper: check if user is a linked owner (coproprietaire with extranet access)
    function isLinkedOwner(condoId) {
      return request.auth != null &&
        request.auth.token.role == 'owner' &&
        request.auth.token.condoId == condoId;
    }

    // Helper: check if linked owner is a board member
    function isLinkedBoardMember(condoId) {
      return isLinkedOwner(condoId) &&
        request.auth.token.isBoardMember == true;
    }

    // Helper: check document/folder access by accessLevel
    function canAccessByLevel(condoId, accessLevel) {
      return canReadCondo(condoId) ||
        (accessLevel == 'all' && isLinkedOwner(condoId)) ||
        (accessLevel == 'board' && isLinkedBoardMember(condoId));
    }

    // Helper: check if user is adding themselves to boardMemberIds (during invitation acceptance)
    function isAddingSelfToBoardMembers() {
      return request.auth != null &&
        // Only boardMemberIds and updatedAt are being changed
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boardMemberIds', 'updatedAt']) &&
        // User is adding themselves (not removing or adding others)
        request.resource.data.boardMemberIds.hasAll(resource.data.boardMemberIds) &&
        request.auth.uid in request.resource.data.boardMemberIds &&
        request.resource.data.boardMemberIds.size() == resource.data.boardMemberIds.size() + 1;
    }

    // Condos collection
    match /condos/{condoId} {
      // Read: owner or any authenticated user with accepted invitation
      // Note: We allow all authenticated users to read basic condo info (name)
      // because checking invitation status in rules would require expensive reads
      // Sensitive data is protected in subcollections
      allow read: if request.auth != null;

      // List: for queries (needs index on ownerId)
      allow list: if request.auth != null;

      // Create: any authenticated user
      allow create: if request.auth != null;

      // Update: owner only, OR user adding themselves to boardMemberIds (during invitation acceptance)
      allow update: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || isAddingSelfToBoardMembers());

      // Delete: owner only
      allow delete: if request.auth != null &&
        resource.data.ownerId == request.auth.uid;

      // Owners subcollection (copropriétaires)
      // Note: Allow authenticated users to read (needed for extranet to check board membership)
      match /owners/{ownerId} {
        allow read: if request.auth != null;
        // Allow condo owner to write, OR allow user to link themselves via invitation
        allow write: if canWriteCondo(condoId) ||
          // Allow self-linking: user can only set their own userId
          (request.auth != null &&
           request.resource.data.userId == request.auth.uid &&
           // Only allow updating userId field (not other fields)
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'updatedAt']));
      }

      // Lots subcollection
      // Note: Allow authenticated users to read (needed for extranet)
      match /lots/{lotId} {
        allow read: if request.auth != null;
        allow write: if canWriteCondo(condoId);
      }

      // Board members (conseil syndical)
      // Note: Allow authenticated users to read (needed for extranet to check conseil membership)
      match /boardMembers/{memberId} {
        allow read: if request.auth != null;
        allow write: if canWriteCondo(condoId);
      }

      // Documents subcollection
      // Note: Fine-grained access control (niveauAcces) is handled client-side
      // because custom claims for coproprietaires are not set up yet
      match /documents/{docId} {
        allow read: if request.auth != null;
        allow create, update, delete: if canWriteCondo(condoId);
      }

      // Folders subcollection
      // Note: Fine-grained access control is handled client-side
      match /folders/{folderId} {
        allow read: if request.auth != null;
        allow create, update, delete: if canWriteCondo(condoId);
      }

      // Distribution keys (clés de répartition)
      match /distributionKeys/{keyId} {
        allow read: if canReadCondo(condoId);
        allow write: if canWriteCondo(condoId);
      }

      // History/audit log
      match /history/{entryId} {
        allow read: if canReadCondo(condoId);
        allow create: if canWriteCondo(condoId);
        allow update, delete: if false;
      }

      // Calls for funds (appels de fonds)
      // Note: Allow authenticated users to read (needed for extranet)
      match /calls/{callId} {
        allow read: if request.auth != null;
        allow write: if canWriteCondo(condoId);

        match /distributions/{distId} {
          allow read: if request.auth != null;
          allow write: if canWriteCondo(condoId);
        }
      }

      // Payments
      // Note: Allow authenticated users to read (needed for extranet)
      match /payments/{paymentId} {
        allow read: if request.auth != null;
        allow write: if canWriteCondo(condoId);
      }

      // General assemblies (AG)
      // Note: Allow authenticated users to read (needed for extranet)
      match /meetings/{meetingId} {
        allow read: if request.auth != null;
        allow write: if canWriteCondo(condoId);

        match /resolutions/{resId} {
          allow read: if request.auth != null;
          allow write: if canWriteCondo(condoId);

          match /votes/{voteId} {
            allow read: if request.auth != null;
            allow write: if canWriteCondo(condoId);
          }
        }

        match /attendances/{attId} {
          allow read: if request.auth != null;
          allow write: if canWriteCondo(condoId);
        }
      }
    }

    // Owner invitations (extranet access)
    match /ownerInvitations/{invitationId} {
      // Read: public for token validation
      allow read: if true;

      // Create: condo owner only
      allow create: if request.auth != null &&
        isCondoOwner(request.resource.data.condoId);

      // Update: when accepting invitation (statut en_attente) or by condo owner
      allow update: if request.auth != null && (
        resource.data.statut == 'en_attente' ||
        isCondoOwner(resource.data.condoId)
      );

      // Delete: condo owner only
      allow delete: if request.auth != null &&
        isCondoOwner(resource.data.condoId);
    }

    // Notification preferences
    match /notificationPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy collections - read-only for migration
    // TODO: Remove these rules after migration
    match /coproprietes/{coproId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /{subcollection}/{docId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /invitations/{code} {
      allow read: if true;
      allow write: if false;
    }

    match /invitationsExtranet/{invitationId} {
      allow read: if true;
      allow write: if false;
    }

    match /invitationsGestionnaire/{invitationId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
