# @storybook/nextjs@8.x only declares peer support for Next 13–15, but the app
# runs Next 16. npm 7+ aborts a clean install on that peer conflict (ERESOLVE),
# which breaks the Vercel build. Storybook isn't part of the production build,
# so accept the mismatch until Storybook is upgraded to a Next-16-compatible
# release (then this can be removed).
legacy-peer-deps=true
